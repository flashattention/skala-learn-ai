# ── 교재 원본 (저작권: SK㈜AX 컨텐츠 자산 — 업로드 금지) ──
# 폴더 구조만 남기고 안의 파일은 모두 제외
source/*
!source/.gitkeep

# ── Firebase ──
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# ── Node / npm ──
node_modules/
npm-debug.log*

# ── Python (로컬 서버·스크립트용) ──
__pycache__/
*.pyc
.venv/
venv/

# ── 비밀 정보 ──
# 서비스 계정 키 (GitHub Secret에만 등록, 커밋 금지)
skala-learn-ai-*.json
*-firebase-adminsdk-*.json
service-account*.json
.env
.env.*
!.env.example

# ── 학습 기록 백업 파일 (사이트에서 내려받은 JSON) ──
skax-study-backup-*.json

# ── OS / 에디터 ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
