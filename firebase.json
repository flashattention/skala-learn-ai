{
  "hosting": {
    "public": "site",
    "ignore": [
      "**/.*"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "node \"$PROJECT_DIR/scripts/sync-content.mjs\""
      ]
    }
  ]
}
